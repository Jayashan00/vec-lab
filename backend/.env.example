# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/learning-platform

# JWT secret used to sign auth tokens - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# OpenAI API key for the GPT course recommendation feature
# Get this from the "GPT API Assessment Instructions" document / your OpenAI account
# NEVER commit your real key - this file only holds placeholders
OPENAI_API_KEY=sk-your-key-here

# Maximum number of GPT API calls allowed for this assessment (per instructions)
GPT_MAX_REQUESTS=250

# Comma separated list of allowed frontend origins for CORS
CLIENT_URL=http://localhost:5173
